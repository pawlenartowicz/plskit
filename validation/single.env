# Pin every backend to one core. Sourced by run.sh; the runners refuse to start without it.
export RAYON_NUM_THREADS=1        # plskit (faer + rayon)
export VECLIB_MAXIMUM_THREADS=1   # Apple Accelerate (numpy, R on macOS)
export OPENBLAS_NUM_THREADS=1     # OpenBLAS (numpy on Linux)
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMBA_NUM_THREADS=1
export BENCH_SINGLE_CORE=1
